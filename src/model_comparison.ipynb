  {
   "cell_type": "markdown",
   "id": "c4090843",
   "metadata": {},
   "source": [
    "### Model Behaviour by Consumption Level\n",
    "\n",
    "The test data is divided into four groups based on actual fuel consumption. This allows the models' predicted values to be compared across different consumption levels."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "50278a94",
   "metadata": {},
   "outputs": [],
   "source": [
    "consumption_group = pd.qcut(\n",
    "    linear[\"actual\"],\n",
    "    q=4,\n",
    "    labels=[\"Lowest\", \"Low-Mid\", \"High-Mid\", \"Highest\"]\n",
    ")\n",
    "\n",
    "linear[\"consumption_group\"] = consumption_group\n",
    "random_forest[\"consumption_group\"] = consumption_group"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8dd07343",
   "metadata": {},
   "source": [
    "#### Actual vs Predicted Fuel Consumption"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "b313adc8",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "rf_group_summary = (\n",
    "    random_forest\n",
    "    .groupby(\"consumption_group\", observed=True)\n",
    "    .agg(\n",
    "        actual_mean=(\"actual\", \"mean\"),\n",
    "        predicted_mean=(\"predicted\", \"mean\")\n",
    "    )\n",
    ")\n",
    "\n",
    "linear_group_summary = (\n",
    "    linear\n",
    "    .groupby(\"consumption_group\", observed=True)\n",
    "    .agg(\n",
    "        actual_mean=(\"actual\", \"mean\"),\n",
    "        predicted_mean=(\"predicted\", \"mean\")\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5), sharey=True)\n",
    "\n",
    "linear_group_summary.plot(\n",
    "    kind=\"bar\",\n",
    "    ax=axes[0]\n",
    ")\n",
    "axes[0].set_title(\"Linear Regression\")\n",
    "axes[0].set_xlabel(\"Actual Consumption Group\")\n",
    "axes[0].set_ylabel(\"Fuel Consumption (L/100 km)\")\n",
    "axes[0].tick_params(axis=\"x\", rotation=0)\n",
    "\n",
    "rf_group_summary.plot(\n",
    "    kind=\"bar\",\n",
    "    ax=axes[1]\n",
    ")\n",
    "axes[1].set_title(\"Random Forest\")\n",
    "axes[1].set_xlabel(\"Actual Consumption Group\")\n",
    "axes[1].set_ylabel(\"\")\n",
    "axes[1].tick_params(axis=\"x\", rotation=0)\n",
    "\n",
    "fig.suptitle(\"Actual vs Predicted Fuel Consumption\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2463615c",
   "metadata": {},
   "source": [
    "The confusion matrices show how often each model assigns vehicles to the correct Low, Medium or High consumption category."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "6242cb46",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "labels = [\"Low\", \"Medium\", \"High\"]\n",
    "\n",
    "linear_cm = confusion_matrix(\n",
    "    linear[\"actual_category\"],\n",
    "    linear[\"predicted_category\"],\n",
    "    labels=labels,\n",
    "    normalize=\"true\"\n",
    ")\n",
    "\n",
    "rf_cm = confusion_matrix(\n",
    "    random_forest[\"actual_category\"],\n",
    "    random_forest[\"predicted_category\"],\n",
    "    labels=labels,\n",
    "    normalize=\"true\"\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
    "\n",
    "linear_display = ConfusionMatrixDisplay(\n",
    "    confusion_matrix=linear_cm,\n",
    "    display_labels=labels\n",
    ")\n",
    "\n",
    "linear_display.plot(\n",
    "    values_format=\".1%\",\n",
    "    cmap=\"Oranges\",\n",
    "    ax=axes[0],\n",
    "    colorbar=False\n",
    ")\n",
    "\n",
    "axes[0].set_title(\"Linear Regression\")\n",
    "\n",
    "\n",
    "rf_display = ConfusionMatrixDisplay(\n",
    "    confusion_matrix=rf_cm,\n",
    "    display_labels=labels\n",
    ")\n",
    "\n",
    "rf_display.plot(\n",
    "    values_format=\".1%\",\n",
    "    cmap=\"Oranges\",\n",
    "    ax=axes[1],\n",
    "    colorbar=False\n",
    ")\n",
    "\n",
    "axes[1].set_title(\"Random Forest\")\n",
    "\n",
    "fig.suptitle(\"Low / Medium / High Consumption Categories\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
