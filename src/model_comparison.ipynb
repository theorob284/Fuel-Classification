  {
   "cell_type": "markdown",
   "id": "7bc16bf0",
   "metadata": {},
   "source": [
    "### 2. Calculate Fuel Consumption Categories"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "d047a56e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Low cutoff: 11.200714285714286\n",
      "High cutoff: 13.0675\n"
     ]
    }
   ],
   "source": [
    "from data_setup import load_data, get_train_test_split\n",
    "\n",
    "df = load_data()\n",
    "\n",
    "X_train, X_test, y_train, y_test = get_train_test_split(df)\n",
    "\n",
    "low_cutoff = y_train.quantile(0.33)\n",
    "high_cutoff = y_train.quantile(0.67)\n",
    "\n",
    "print(\"Low cutoff:\", low_cutoff)\n",
    "print(\"High cutoff:\", high_cutoff)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "1d9f3eb3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def classify_consumption(value):\n",
    "    if value < low_cutoff:\n",
    "        return \"Low\"\n",
    "    elif value < high_cutoff:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"High\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "72badd7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "linear[\"actual_category\"] = linear[\"actual\"].apply(classify_consumption)\n",
    "linear[\"predicted_category\"] = linear[\"predicted\"].apply(classify_consumption)\n",
    "\n",
    "random_forest[\"actual_category\"] = random_forest[\"actual\"].apply(classify_consumption)\n",
    "random_forest[\"predicted_category\"] = random_forest[\"predicted\"].apply(classify_consumption)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6d5a617b",
   "metadata": {},
   "source": [
    "### 3. Calculate Category Accuracy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "06050bfa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Linear Regression: 0.8191823899371069\n",
      "Random Forest: 0.8776443682104059\n"
     ]
    }
   ],
   "source": [
    "linear_category_accuracy = (\n",
    "    linear[\"actual_category\"] == linear[\"predicted_category\"]\n",
    ").mean()\n",
    "\n",
    "rf_category_accuracy = (\n",
    "    random_forest[\"actual_category\"] == random_forest[\"predicted_category\"]\n",
    ").mean()\n",
    "\n",
    "print(\"Linear Regression:\", linear_category_accuracy)\n",
    "print(\"Random Forest:\", rf_category_accuracy)"
   ]
  },
  {
